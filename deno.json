{
  "name": "xteink-sync",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "tasks": {
    "dev": "deno run --allow-read --allow-write --allow-net --allow-run --allow-env --allow-sys --unstable-net --unstable-raw-imports --watch src/main.ts",
    "start": "deno run --allow-read --allow-write --allow-net --allow-run --allow-env --allow-sys --unstable-net --unstable-raw-imports src/main.ts",
    "desktop": "deno desktop --allow-read --allow-write --allow-net --allow-run --allow-env --allow-sys --unstable-net --unstable-raw-imports src/main.ts",
    "build": "deno desktop --allow-read --allow-write --allow-net --allow-run --allow-env --allow-sys --unstable-net --unstable-raw-imports --output dist/XteinkSync.app src/main.ts",
    "setup": "bash scripts/setup.sh",
    "vendor": "bash engine/fetch_vendor.sh",
    "package": "deno run -A scripts/package.ts",
    "python": "deno run -A scripts/fetch_python.ts",
    "acceptance": "bash tests/acceptance.sh",
    "test": "deno test --allow-read --allow-write --allow-env --allow-run --allow-net --unstable-net --unstable-raw-imports",
    "check": "deno check --unstable-net --unstable-raw-imports src/main.ts tests/*.ts && deno lint && deno fmt --check"
  },
  "desktop": {
    "app": {
      "name": "Xteink Sync",
      "identifier": "com.xteink.sync",
      "icons": {
        "macos": "assets/icon.png"
      }
    },
    "backend": "webview"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "@std/tar/untar-stream": "jsr:@std/tar@^0.1.10/untar-stream"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["engine/vendor", "dist"]
  },
  "lint": {
    "exclude": ["engine/vendor", "dist"]
  },
  "exclude": ["dist", "engine/vendor", "engine/.venv"]
}
